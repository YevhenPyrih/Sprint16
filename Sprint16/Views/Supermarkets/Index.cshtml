@model IEnumerable<Sprint16.Models.Supermarket>

@{
    ViewData["Title"] = "Index";
    int perPage = 1;
    var list = Model.ToList();
    
    int totalPages = (int)Math.Ceiling((double)list.Count / perPage);
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Address)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @{
            int start = ViewBag.Page * perPage;
            int end = Math.Min(start + perPage, list.Count);
        }
        @for (int i = start; i < end; i++)
        {
            <tr>
                <td>
                    @Html.DisplayFor(model => list[i].Name)
                </td>
                <td>
                    @Html.DisplayFor(model => list[i].Address)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@list[i].Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@list[i].Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@list[i].Id">Delete</a>
                </td>
            </tr>
        }
        <tr>
            <td>
                @if (ViewBag.Page > 0)
                {
                    <a asp-action="Index" asp-route-page="@(ViewBag.Page - 1)">Previous</a>
                }
                else
                {
                    <span>Previous</span>
                }
            </td>

            <td>
                @if (ViewBag.Page < totalPages - 1)
                {
                    <a asp-action="Index" asp-route-page="@(ViewBag.Page + 1)">Next</a>
                }
                else
                {
                    <span>Next</span>
                }
            </td>
            <td></td>
        </tr>
    </tbody>
</table>